{
    "name": "filaforge-studio/filaforge-studio",
    "description": "RTL-first visual page builder for Filament 5",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/dehnavi/filaforge-studio",
    "support": {
        "issues": "https://github.com/dehnavi/filaforge-studio/issues",
        "source": "https://github.com/dehnavi/filaforge-studio"
    },
    "keywords": [
        "laravel",
        "filament",
        "filament-5",
        "page-builder",
        "visual-editor",
        "rtl",
        "persian"
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "symfony/html-sanitizer": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "FilaForge\\Studio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FilaForge\\Studio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FilaForge\\Studio\\FilaForgeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.transfer-backups",
            "/workbench",
            "/composer.lock",
            "/tests",
            "/.github"
        ]
    },
    "suggest": {
        "ext-intl": "Persian calendar date formatting (persian_date)"
    }
}
